rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public username lookup for email resolution during sign-in
    match /usernames/{username} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // User profile and user-scoped data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User-scoped personal expenses
    match /expenses/{expenseId} {
      allow read, write: if request.auth != null;
    }

    // Fixed recurring bills
    match /fixedExpenses/{fixedId} {
      allow read, write: if request.auth != null;
    }

    // Pooled group members
    match /members/{memberId} {
      allow read, write: if request.auth != null;
    }

    // Planner tasks
    match /plannerTasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    // Savings goals
    match /financialGoals/{goalId} {
      allow read, write: if request.auth != null;
    }
  }
}
